{
  "name": "lakehouse-academy",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "content": "node scripts/split-content.mjs",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:db": "tsx --tsconfig tests/tsconfig.json tests/db.test.ts",
    "test": "npm run test:db",
    "preview": "npm run content && PREVIEW=1 next dev",
    "verify:db": "node scripts/verify-db.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@neondatabase/serverless": "^0.10.4",
    "@tailwindcss/typography": "^0.5.16",
    "drizzle-orm": "^0.38.4",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "next": "15.1.6",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "postcss": "^8.5.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
