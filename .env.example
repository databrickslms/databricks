# ─── Database (Neon — free tier, never expires) ────────────────────────────────
# Create a project at https://neon.tech, copy the POOLED connection string.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Your deployed origin. Locally: http://localhost:3000
AUTH_URL="http://localhost:3000"
# Required on Render (it terminates TLS at the proxy).
AUTH_TRUST_HOST="true"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Course config ────────────────────────────────────────────────────────────
# Comma-separated emails granted the instructor dashboard.
INSTRUCTOR_EMAILS="you@yourcompany.com"
# Optional: restrict sign-in to one or more email domains. Blank = anyone.
ALLOWED_EMAIL_DOMAINS=""
